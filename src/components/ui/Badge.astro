---
interface Props {
  class?: string;
  variant?: "default" | "outline" | "neutral" | "accent";
}

const { variant = "default", class: className } = Astro.props;

const variants = {
  accent:
    "bg-white text-black font-semibold border border-white shadow-[0_0_12px_rgba(255,255,255,0.2)]",
  default:
    "bg-white/[0.06] text-white/90 border border-white/10 shadow-[inset_0_1px_0_0_rgba(255,255,255,0.1)]",
  neutral: "bg-zinc-900 text-zinc-300 border border-zinc-800/80",
  outline: "bg-transparent border border-white/15 text-zinc-300",
};
---

<span
  class:list={[
    "inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium tracking-wide backdrop-blur-md select-none",
    variants[variant],
    className,
  ]}
>
  <slot />
</span>
