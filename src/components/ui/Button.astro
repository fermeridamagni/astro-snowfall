---
interface Props {
  class?: string;
  href?: string;
  size?: "sm" | "md" | "lg";
  variant?: "primary" | "secondary" | "outline" | "ghost";
  [key: string]: any;
}

const {
  variant = "primary",
  size = "md",
  href,
  class: className,
  ...rest
} = Astro.props;

const variants = {
  ghost: "text-zinc-400 hover:text-white hover:bg-white/5",
  outline:
    "border border-white/15 text-white/90 hover:bg-white/5 hover:border-white/30 shadow-xs",
  primary:
    "bg-white text-black font-semibold hover:bg-zinc-200 border border-white shadow-[0_1px_2px_rgba(0,0,0,0.1),0_0_20px_rgba(255,255,255,0.15)]",
  secondary:
    "bg-white/[0.06] hover:bg-white/[0.1] text-white border border-white/10 shadow-xs backdrop-blur-md",
};

const sizes = {
  lg: "px-6 py-3.5 text-base font-medium",
  md: "px-4 py-2 text-sm font-medium",
  sm: "px-3 py-1.5 text-xs font-medium",
};

const styles = `
  inline-flex items-center justify-center gap-2 rounded-full cursor-pointer
  transition-all duration-150 ease-out select-none interactive-press
  active:scale-[0.98] active:opacity-90
  ${variants[variant]} 
  ${sizes[size]} 
  ${className || ""}
`;

const Tag = href ? "a" : "button";
const rel =
  href && rest.target === "_blank"
    ? rest.rel || "noopener noreferrer"
    : rest.rel;
---

<Tag class={styles} href={href} {...rest} rel={rel}>
  <slot />
</Tag>
