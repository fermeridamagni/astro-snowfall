---
interface Props {
  class?: string;
  hoverEffect?: boolean;
}

const { class: className, hoverEffect = true } = Astro.props;
---

<div
  class:list={[
    "relative rounded-2xl border border-white/[0.08] bg-white/[0.02] p-6 backdrop-blur-xl shadow-[inset_0_1px_0_0_rgba(255,255,255,0.08)]",
    hoverEffect &&
      "transition-all duration-300 hover:border-white/20 hover:bg-white/[0.04]",
    className,
  ]}
>
  <div class="relative z-10">
    <slot />
  </div>
</div>
