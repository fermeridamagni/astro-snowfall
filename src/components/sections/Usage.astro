---
import Snowfall from "@components/Snowfall.astro";
import Badge from "@ui/Badge.astro";
import CodeBlock from "@ui/CodeBlock.astro";

const containerSnippet = `---
import Snowfall from "astro-snowfall";
---

<div class="relative w-full h-80 rounded-2xl overflow-hidden border border-white/10 bg-black">
  <Snowfall snowflakeCount={60} speed={[0.8, 1.8]} />
  
  <div class="relative z-10 flex h-full items-center justify-center">
    <h2 class="text-2xl font-bold text-white">Container Bound</h2>
  </div>
</div>`;

const fullscreenSnippet = `---
import Snowfall from "astro-snowfall";
---

<!-- Fixed background across the entire viewport -->
<div class="fixed inset-0 z-0 pointer-events-none">
  <Snowfall 
    color="#ffffff"
    snowflakeCount={120} 
    speed={[0.5, 2.0]}
    wind={[-0.3, 0.6]}
  />
</div>`;
---

<section class="py-20 sm:py-28 relative reveal-section w-full overflow-hidden" id="usage">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 w-full min-w-0">
    <!-- Header -->
    <div class="reveal-header text-center max-w-2xl mx-auto mb-16 sm:mb-20">
      <h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-white mb-4">
        Usage
      </h2>
      <p class="text-zinc-400 text-sm sm:text-lg">
        Drop into any Astro page or layout. Works out of the box with zero configuration.
      </p>
    </div>

    <div class="space-y-16 sm:space-y-20 w-full min-w-0">
      <!-- Use Case 1: Container Bound -->
      <div class="reveal-card grid lg:grid-cols-12 gap-6 lg:gap-8 items-center w-full min-w-0">
        <div class="lg:col-span-5 space-y-4 w-full min-w-0">
          <Badge variant="default">Pattern 01</Badge>
          <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
            Container Bound Snowfall
          </h3>
          <p class="text-sm sm:text-base text-zinc-400 leading-relaxed">
            By default, the canvas automatically attaches to and resizes with its parent container. Perfect for hero banners, cards, or festive promotional callouts.
          </p>
          <ul class="space-y-2 text-xs sm:text-sm text-zinc-300 font-mono">
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-white/60 shrink-0"></span>
              <span>Auto-sizes via ResizeObserver</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-white/60 shrink-0"></span>
              <span>Parent needs relative positioning</span>
            </li>
          </ul>
        </div>

        <div class="lg:col-span-7 space-y-4 w-full min-w-0">
          <!-- Live Container Sandbox Preview -->
          <div class="relative h-40 sm:h-44 rounded-xl border border-white/10 overflow-hidden bg-black shadow-lg w-full">
            <Snowfall snowflakeCount={40} speed={[0.8, 1.8]} radius={[0.8, 2.2]} color="#ffffff" />
            <div class="relative z-10 flex h-full items-center justify-center pointer-events-none">
              <div class="glass-chrome px-4 py-2 rounded-full text-xs font-mono text-zinc-300">
                Interactive Preview
              </div>
            </div>
          </div>
          
          <CodeBlock code={containerSnippet} lang="astro" title="src/components/FestiveBanner.astro" />
        </div>
      </div>

      <!-- Divider -->
      <div class="border-t border-white/[0.06]"></div>

      <!-- Use Case 2: Fullscreen Background -->
      <div class="reveal-card grid lg:grid-cols-12 gap-6 lg:gap-8 items-center w-full min-w-0">
        <div class="lg:col-span-5 lg:order-2 space-y-4 w-full min-w-0">
          <Badge variant="default">Pattern 02</Badge>
          <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
            Global Viewport Background
          </h3>
          <p class="text-sm sm:text-base text-zinc-400 leading-relaxed">
            Fix the canvas across your layout so snow gently falls as visitors scroll through pages. Non-blocking with pointer-events disabled by design.
          </p>
          <ul class="space-y-2 text-xs sm:text-sm text-zinc-300 font-mono">
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-white/60 shrink-0"></span>
              <span>Non-interfering clicks (pointer-events-none)</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-white/60 shrink-0"></span>
              <span>Seamless multi-page transitions</span>
            </li>
          </ul>
        </div>

        <div class="lg:col-span-7 lg:order-1 w-full min-w-0">
          <CodeBlock code={fullscreenSnippet} lang="astro" title="src/layouts/Layout.astro" />
        </div>
      </div>
    </div>
  </div>
</section>
