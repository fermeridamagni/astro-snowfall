---
import GithubIcon from "@components/icons/github-icon.astro";
import Snowfall from "@components/Snowfall.astro";
import Badge from "@ui/Badge.astro";
import Button from "@ui/Button.astro";
import { CopyButton } from "@components/animate-ui/components/buttons/copy";
---

<section
  class="relative min-h-[92vh] flex items-center justify-center overflow-hidden pt-28 pb-16"
  id="hero"
>
  <!-- Interactive Snowfall Canvas Layer -->
  <div class="absolute inset-0 z-0 pointer-events-none opacity-60">
    <Snowfall
      enable3DRotation={true}
      radius={[0.6, 2.8]}
      snowflakeCount={90}
      speed={[0.6, 2.2]}
      wind={[-0.4, 0.8]}
      rotationSpeed={[-0.5, 0.5]}
      color="#ffffff"
    />
  </div>

  <!-- Subtle Radial Gradient Vignette -->
  <div
    class="absolute inset-0 z-0 pointer-events-none bg-[radial-gradient(circle_at_50%_40%,rgba(255,255,255,0.03)_0%,transparent_70%)]"
  >
  </div>

  <div
    class="relative z-10 w-full max-w-5xl mx-auto px-4 sm:px-6 flex flex-col items-center text-center"
  >
    <!-- Badge -->
    <div class="animate-hero-badge mb-8">
      <Badge variant="default" class="px-3.5 py-1.5 border-white/10 bg-white/[0.04]">
        <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
        <span class="text-xs font-mono text-zinc-300">v1.0 • Pure Canvas & 60 FPS</span>
      </Badge>
    </div>

    <!-- Title -->
    <h1
      class="animate-hero-title text-5xl sm:text-7xl lg:text-8xl font-bold tracking-tight text-silver-gradient mb-6 max-w-4xl"
    >
      Snowfall for Astro.
    </h1>

    <!-- Description -->
    <p
      class="animate-hero-desc text-lg sm:text-xl text-zinc-400 max-w-2xl mx-auto mb-10 leading-relaxed font-normal"
    >
      A lightweight, performant canvas-based snowfall background animation
      component engineered for Astro and TypeScript. Zero dependencies.
    </p>

    <!-- CTAs -->
    <div
      class="animate-hero-cta flex flex-wrap items-center justify-center gap-4 mb-10"
    >
      <Button href="#installation" size="lg" variant="primary">
        Get Started
        <svg
          class="w-4 h-4 ml-1"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m9 18 6-6-6-6"></path>
        </svg>
      </Button>

      <Button
        href="https://github.com/fermeridamagni/astro-snowfall"
        size="lg"
        target="_blank"
        variant="secondary"
      >
        <GithubIcon class="w-4 h-4" />
        GitHub
      </Button>
    </div>

    <!-- Quick Copy Command -->
    <div class="animate-hero-snippet w-full max-w-md mx-auto">
      <div
        class="glass-card rounded-full px-4 py-2 flex items-center justify-between border border-white/10 text-xs font-mono text-zinc-300"
      >
        <div class="flex items-center gap-2 overflow-hidden">
          <span class="text-zinc-500 select-none">$</span>
          <span class="truncate">bun add astro-snowfall</span>
        </div>
        <CopyButton
          className="p-1.5 rounded-full hover:bg-white/10 text-zinc-400 hover:text-white transition-colors"
          content="bun add astro-snowfall"
          client:idle
        />
      </div>
    </div>
  </div>

  <!-- Bottom seamless fade -->
  <div
    class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-black to-transparent pointer-events-none z-10"
  >
  </div>
</section>
