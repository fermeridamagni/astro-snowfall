---
import Card from "@ui/Card.astro";
import { CopyButton } from "@components/animate-ui/components/buttons/copy";

const managers = [
  { id: "bun", label: "bun", cmd: "bun add astro-snowfall" },
  { id: "pnpm", label: "pnpm", cmd: "pnpm add astro-snowfall" },
  { id: "npm", label: "npm", cmd: "npm install astro-snowfall" },
  { id: "yarn", label: "yarn", cmd: "yarn add astro-snowfall" },
  {
    id: "shadcn",
    label: "shadcn",
    cmd: "npx shadcn@latest add https://fermeridamagni.github.io/astro-snowfall/r/snowfall.json",
  },
];
---

<section class="py-28 relative reveal-section" id="installation">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Section Header -->
    <div class="reveal-header text-center max-w-2xl mx-auto mb-16">
      <h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-white mb-4">
        Installation
      </h2>
      <p class="text-zinc-400 text-base sm:text-lg">
        Add the snowfall component to your Astro project with a single command.
      </p>
    </div>

    <!-- Package Manager Terminal Card -->
    <div class="reveal-card max-w-3xl mx-auto mb-16">
      <div
        class="rounded-2xl border border-white/10 bg-[#070709] shadow-2xl overflow-hidden shadow-[inset_0_1px_0_0_rgba(255,255,255,0.08)]"
      >
        <!-- Tab Bar -->
        <div
          class="flex items-center justify-between border-b border-white/[0.06] bg-white/[0.02] px-4 py-2.5"
        >
          <div class="flex items-center gap-1.5">
            <div class="w-2.5 h-2.5 rounded-full bg-white/15 border border-white/20"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-white/15 border border-white/20"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-white/15 border border-white/20"></div>
          </div>

          <div
            class="flex items-center gap-1 bg-black/40 p-1 rounded-lg border border-white/[0.06]"
            id="pm-tabs"
          >
            {
              managers.map((pm, idx) => (
                <button
                  type="button"
                  data-target={pm.id}
                  class:list={[
                    "pm-tab px-2.5 py-1 text-xs font-mono rounded-md transition-all interactive-press",
                    idx === 0
                      ? "bg-white text-black font-semibold shadow-xs"
                      : "text-zinc-400 hover:text-white",
                  ]}
                >
                  {pm.label}
                </button>
              ))
            }
          </div>
        </div>

        <!-- Command Views -->
        <div class="p-6 relative">
          {
            managers.map((pm, idx) => (
              <div
                id={`pm-view-${pm.id}`}
                class:list={[
                  "pm-view items-center justify-between gap-4 font-mono text-sm",
                  idx === 0 ? "flex" : "hidden",
                ]}
              >
                <div class="flex items-center gap-3 overflow-x-auto text-zinc-200">
                  <span class="text-zinc-500 select-none">$</span>
                  <span class="pm-cmd-text whitespace-nowrap">{pm.cmd}</span>
                </div>
                <CopyButton
                  className="shrink-0 p-2 rounded-lg bg-white/[0.06] hover:bg-white/[0.12] text-zinc-300 hover:text-white transition-all border border-white/10"
                  content={pm.cmd}
                  client:idle
                />
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Architectural Pillars Bento Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="reveal-card">
        <Card class="h-full flex flex-col justify-between">
          <div>
            <div class="text-xs font-mono text-zinc-500 uppercase tracking-widest mb-3">
              Architecture
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">
              Zero Dependencies
            </h3>
            <p class="text-sm text-zinc-400 leading-relaxed">
              Engineered with pure TypeScript and HTML5 Canvas API. No external animation engine required.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-white/[0.06] text-xs font-mono text-zinc-400">
            0 runtime packages
          </div>
        </Card>
      </div>

      <div class="reveal-card">
        <Card class="h-full flex flex-col justify-between">
          <div>
            <div class="text-xs font-mono text-zinc-500 uppercase tracking-widest mb-3">
              Footprint
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">
              ~3kb Gzipped
            </h3>
            <p class="text-sm text-zinc-400 leading-relaxed">
              Ultra-compact script size ensures zero noticeable impact on First Contentful Paint.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-white/[0.06] text-xs font-mono text-zinc-400">
            Minimal payload
          </div>
        </Card>
      </div>

      <div class="reveal-card">
        <Card class="h-full flex flex-col justify-between">
          <div>
            <div class="text-xs font-mono text-zinc-500 uppercase tracking-widest mb-3">
              Performance
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">
              60 FPS Hardware RAF
            </h3>
            <p class="text-sm text-zinc-400 leading-relaxed">
              IntersectionObserver pauses canvas rendering when offscreen, conserving GPU and battery.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-white/[0.06] text-xs font-mono text-zinc-400">
            Auto-throttling
          </div>
        </Card>
      </div>

      <div class="reveal-card">
        <Card class="h-full flex flex-col justify-between">
          <div>
            <div class="text-xs font-mono text-zinc-500 uppercase tracking-widest mb-3">
              Integration
            </div>
            <h3 class="text-lg font-semibold text-white mb-2">
              Astro Native
            </h3>
            <p class="text-sm text-zinc-400 leading-relaxed">
              Compatible with Astro Island architecture, SSG, SSR, and ClientRouter View Transitions.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-white/[0.06] text-xs font-mono text-zinc-400">
            ViewTransitions safe
          </div>
        </Card>
      </div>
    </div>
  </div>
</section>

<script>
  function setupPmTabs() {
    const tabs = document.querySelectorAll<HTMLButtonElement>(".pm-tab");
    const views = document.querySelectorAll<HTMLElement>(".pm-view");

    for (const tab of tabs) {
      tab.addEventListener("click", () => {
        const targetId = tab.dataset.target;
        if (!targetId) return;

        // Reset all tabs
        for (const t of tabs) {
          t.classList.remove("bg-white", "text-black", "font-semibold", "shadow-xs");
          t.classList.add("text-zinc-400");
        }

        // Activate clicked tab
        tab.classList.add("bg-white", "text-black", "font-semibold", "shadow-xs");
        tab.classList.remove("text-zinc-400");

        // Toggle views
        for (const view of views) {
          if (view.id === `pm-view-${targetId}`) {
            view.classList.remove("hidden");
            view.classList.add("flex");
          } else {
            view.classList.add("hidden");
            view.classList.remove("flex");
          }
        }
      });
    }
  }

  setupPmTabs();
  document.addEventListener("astro:page-load", setupPmTabs);
</script>
