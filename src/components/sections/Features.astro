---
import Card from "@ui/Card.astro";
import {
  Layers,
  Monitor,
  Rotate3d,
  ShieldCheck,
  Sliders,
  Zap,
} from "@lucide/astro";

const features = [
  {
    icon: Zap,
    title: "Optimized Performance",
    badge: "60 FPS",
    description:
      "Batch rendering via requestAnimationFrame with automatic IntersectionObserver pausing to preserve mobile battery and CPU cycles.",
  },
  {
    icon: Sliders,
    title: "Fine-Grained Controls",
    badge: "Configurable",
    description:
      "Precision props for snowflake count, speed range, horizontal wind drift, opacity intervals, particle radii, and custom colors.",
  },
  {
    icon: Monitor,
    title: "Retina & Responsive",
    badge: "High-DPI",
    description:
      "Dynamic ResizeObserver automatically matches container dimensions with pixel-ratio scaling so particles remain razor-sharp on Retina screens.",
  },
  {
    icon: Rotate3d,
    title: "3D Tumbling Physics",
    badge: "Spatial",
    description:
      "Optional pseudo-3D transformation matrices simulate realistic leaf and crystal tumbling along pitch and roll rotation axes.",
  },
  {
    icon: ShieldCheck,
    title: "Strict Type Safety",
    badge: "TypeScript",
    description:
      "100% typed with exported interfaces. Complete IDE auto-completion and compile-time validation for all configuration options.",
  },
  {
    icon: Layers,
    title: "Astro Island Compatible",
    badge: "Zero Bloat",
    description:
      "Engineered to blend with Astro's island architecture. Zero heavy JavaScript hydration cost when rendered statically.",
  },
];
---

<section class="py-20 sm:py-28 relative reveal-section w-full overflow-hidden" id="features">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 w-full min-w-0">
    <!-- Header -->
    <div class="reveal-header text-center max-w-2xl mx-auto mb-12 sm:mb-16">
      <h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-white mb-4">
        Engineered for Elegance.
      </h2>
      <p class="text-zinc-400 text-sm sm:text-lg">
        Designed from the canvas up with attention to every frame, pixel, and byte.
      </p>
    </div>

    <!-- Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5 w-full min-w-0">
      {
        features.map((feature) => {
          const Icon = feature.icon;
          return (
            <div class="reveal-card w-full min-w-0">
              <Card class="h-full flex flex-col justify-between p-5 sm:p-6 w-full min-w-0">
                <div>
                  <div class="flex items-center justify-between mb-4 sm:mb-5">
                    <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-white/[0.06] border border-white/10 flex items-center justify-center text-white shrink-0">
                      <Icon class="w-4 h-4 sm:w-5 sm:h-5 text-zinc-200" />
                    </div>
                    <span class="text-[10px] sm:text-[11px] font-mono uppercase tracking-wider text-zinc-400 bg-white/[0.03] px-2 py-0.5 rounded border border-white/[0.06]">
                      {feature.badge}
                    </span>
                  </div>

                  <h3 class="text-base sm:text-lg font-semibold text-white mb-2 tracking-tight">
                    {feature.title}
                  </h3>
                  <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed font-normal">
                    {feature.description}
                  </p>
                </div>
              </Card>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
