---
import Snowfall from "@components/Snowfall.astro";
import type { SnowfallCanvasConfig } from "@lib/snowfall/types";
import CodeBlock from "@ui/CodeBlock.astro";

interface ExamplePreset {
  badge: string;
  code: string;
  description: string;
  props: SnowfallCanvasConfig;
  title: string;
}

const presets: ExamplePreset[] = [
  {
    badge: "Subtle",
    code: `<Snowfall
  snowflakeCount={45}
  speed={[0.5, 1.5]}
  wind={[-0.4, 0.4]}
  radius={[0.6, 2.0]}
  opacity={[0.3, 0.8]}
/>`,
    description: "Quiet, delicate snowfall with soft drift and varied transparency.",
    props: {
      color: "#ffffff",
      opacity: [0.3, 0.8],
      radius: [0.6, 2.0],
      snowflakeCount: 45,
      speed: [0.5, 1.5],
      wind: [-0.4, 0.4],
    },
    title: "Gentle Flurry",
  },
  {
    badge: "Dynamic",
    code: `<Snowfall
  snowflakeCount={110}
  speed={[3.5, 7.5]}
  wind={[-2.5, 1.5]}
  radius={[0.5, 2.5]}
/>`,
    description: "Dense, rapid snowfall with strong directional crosswind.",
    props: {
      color: "#e4e4e7",
      radius: [0.5, 2.5],
      snowflakeCount: 110,
      speed: [3.5, 7.5],
      wind: [-2.5, 1.5],
    },
    title: "Mountain Blizzard",
  },
  {
    badge: "Spatial 3D",
    code: `<Snowfall
  enable3DRotation={true}
  rotationSpeed={[-3, 3]}
  snowflakeCount={65}
  speed={[1.2, 2.8]}
/>`,
    description: "Multi-axis tumbling crystals simulating spatial orientation.",
    props: {
      color: "#ffffff",
      enable3DRotation: true,
      rotationSpeed: [-3, 3],
      snowflakeCount: 65,
      speed: [1.2, 2.8],
    },
    title: "Tumbling Crystals",
  },
];
---

<section class="py-28 relative reveal-section" id="examples">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="reveal-header text-center max-w-2xl mx-auto mb-16">
      <h2 class="text-3xl sm:text-5xl font-bold tracking-tight text-white mb-4">
        Interactive Presets
      </h2>
      <p class="text-zinc-400 text-base sm:text-lg">
        Explore different atmospheres by adjusting speed, wind, density, and 3D tumbling physics.
      </p>
    </div>

    <!-- 3-Column Showcase Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      {
        presets.map((preset) => (
          <div class="reveal-card flex flex-col gap-4">
            <!-- Canvas Preview Container -->
            <div class="relative h-64 rounded-2xl overflow-hidden border border-white/10 bg-[#070709] shadow-lg group">
              <Snowfall {...preset.props} />

              <!-- Overlay info bar -->
              <div class="absolute inset-x-0 bottom-0 p-4 bg-gradient-to-t from-black/90 via-black/40 to-transparent flex items-end justify-between pointer-events-none">
                <div>
                  <div class="flex items-center gap-2 mb-1">
                    <h3 class="text-white font-semibold text-base tracking-tight">
                      {preset.title}
                    </h3>
                    <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-white/10 text-zinc-300 border border-white/10">
                      {preset.badge}
                    </span>
                  </div>
                  <p class="text-xs text-zinc-400 line-clamp-1">
                    {preset.description}
                  </p>
                </div>
              </div>
            </div>

            <!-- Code Snippet -->
            <CodeBlock code={preset.code} lang="astro" />
          </div>
        ))
      }
    </div>
  </div>
</section>
