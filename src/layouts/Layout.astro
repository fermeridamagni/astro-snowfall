---
import { ClientRouter } from "astro:transitions";
import Snowfall from "@components/Snowfall.astro";
import Header from "@components/sections/Header.astro";
import "@styles/global.css";

interface Props {
  description?: string;
  image?: string;
  title: string;
  type?: string;
}

const {
  title,
  description = "A lightweight, performant canvas-based snowfall background animation component built with Astro and TypeScript.",
  image = "/preview.png",
  type = "website",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html class="dark antialiased scroll-smooth" lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta content={description} name="description" />
    <meta content="width=device-width, initial-scale=1.0, maximum-scale=5.0" name="viewport" />
    <link href={canonicalURL} rel="canonical" />

    <!-- General Meta Tags -->
    <meta content="fermeridamagni" name="author" />
    <link href="https://github.com/fermeridamagni" rel="author" />
    <meta content="fermeridamagni" name="publisher" />
    <meta content="fermeridamagni" name="creator" />
    <meta
      content="astro, snowfall, animation, canvas, typescript, component, web design, minimalist, monochrome"
      name="keywords"
    />
    <meta content={Astro.generator} name="generator" />

    <!-- Open Graph / Facebook -->
    <meta content={type} property="og:type" />
    <meta content={Astro.url} property="og:url" />
    <meta content={title} property="og:title" />
    <meta content={description} property="og:description" />
    <meta
      content={new URL(
        `${import.meta.env.BASE_URL.replace(/\/$/, "")}${image.startsWith("/") ? image : `/${image}`}`,
        Astro.site,
      )}
      property="og:image"
    />

    <!-- Twitter -->
    <meta content="summary_large_image" property="twitter:card" />
    <meta content={Astro.url} property="twitter:url" />
    <meta content={title} property="twitter:title" />
    <meta content={description} property="twitter:description" />
    <meta
      content={new URL(
        `${import.meta.env.BASE_URL.replace(/\/$/, "")}${image.startsWith("/") ? image : `/${image}`}`,
        Astro.site,
      )}
      property="twitter:image"
    />
    <meta content="@fermeridamagni" property="twitter:creator" />

    <link
      href={`${import.meta.env.BASE_URL}/favicon.svg`}
      rel="icon"
      type="image/svg+xml"
    />
    <title>{title}</title>

    <!-- Google Fonts: Inter with optical tracking -->
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin href="https://fonts.gstatic.com" rel="preconnect" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <ClientRouter />
  </head>
  <body class="bg-black text-white selection:bg-white/20 selection:text-white w-full max-w-[100vw] overflow-x-hidden">
    <!-- Floating Header -->
    <Header />

    <!-- Global Subtle Snowfall Background -->
    <div class="fixed inset-0 z-0 pointer-events-none opacity-40">
      <Snowfall
        color="#ffffff"
        opacity={[0.2, 0.6]}
        radius={[0.5, 2.0]}
        snowflakeCount={60}
        speed={[0.4, 1.4]}
        wind={[-0.2, 0.4]}
      />
    </div>

    <!-- Main Content Slot -->
    <slot />

    <!-- GSAP Animation Engine Integration -->
    <script>
      import { initAnimations, cleanupAnimations } from "../scripts/animations";

      initAnimations();
      document.addEventListener("astro:page-load", initAnimations);
      document.addEventListener("astro:before-preparation", cleanupAnimations);
    </script>
  </body>
</html>
